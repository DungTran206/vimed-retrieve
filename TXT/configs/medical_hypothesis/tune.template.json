{
  "schema_version": 1,
  "cache": "TXT/runtime/medical_hypothesis/cache/cache.jsonl",
  "validation": "val.jsonl",
  "model": "TXT/runtime/medical_hypothesis/fit/model.json",
  "split_path": "TXT/runtime/medical_hypothesis/fit/splits.json",
  "grid": {
    "selection.threshold": [
      0.4,
      0.5,
